// Claude usage display for the ESP32-S3-BOX-3 (320x240).
//
// Rectangles, text and one unscaled image: the MCU software renderer draws
// those line by line without a framebuffer, which is what the board support
// relies on.

global Palette {
    out property <color> background: #141413;
    out property <color> surface: #1f1e1d;
    out property <color> track: #30302e;
    out property <color> text: #faf9f5;
    out property <color> muted: #9c9a92;
    out property <color> accent: #d97757;
    out property <color> caution: #e0a33e;
    out property <color> danger: #e5534b;
    out property <color> ok: #6fb37a;
}

component UsageMeter inherits Rectangle {
    in property <string> title;
    in property <string> window;
    in property <bool> known;
    in property <int> percent;
    in property <string> reset-text;
    // How far through the window we are, 0..1; negative when unknown.
    in property <float> elapsed: -1;

    property <color> level-color: root.percent >= 90 ? Palette.danger
        : root.percent >= 70 ? Palette.caution
        : Palette.accent;

    background: Palette.surface;
    border-radius: 10px;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 9px;
        padding-bottom: 11px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 6px;

            VerticalLayout {
                alignment: end;
                spacing: 1px;

                Text {
                    text: root.title;
                    color: Palette.text;
                    font-size: 13px;
                    font-weight: 700;
                    letter-spacing: 1px;
                }

                Text {
                    text: root.known ? root.reset-text : root.window;
                    color: Palette.muted;
                    font-size: 12px;
                }
            }

            Text {
                horizontal-alignment: right;
                vertical-alignment: bottom;
                text: root.known ? "\{root.percent}%" : "--";
                color: root.known ? root.level-color : Palette.muted;
                font-size: 34px;
                font-weight: 700;
            }
        }

        bar := Rectangle {
            height: 12px;
            border-radius: 6px;
            background: Palette.track;
            clip: true;

            Rectangle {
                x: 0;
                width: root.known ? parent.width * clamp(root.percent, 0, 100) / 100 : 0;
                border-radius: 6px;
                background: root.level-color;

                animate width {
                    duration: 400ms;
                    easing: ease-out;
                }
            }

            // Where an even burn rate would be by now: fill past the tick
            // means the window runs out before it resets.
            if root.known && root.elapsed >= 0: Rectangle {
                x: clamp(parent.width * root.elapsed - 1px, 0px, parent.width - 2px);
                width: 2px;
                background: Palette.text;
                opacity: 0.85;
            }
        }
    }
}

component DialogButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked();

    height: 36px;
    border-radius: 8px;
    background: touch.pressed ? (root.primary ? Palette.danger.darker(20%) : Palette.track.brighter(30%))
        : root.primary ? Palette.danger : Palette.track;

    Text {
        text: root.text;
        color: Palette.text;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// First-run setup: a QR code on the left, what to do with it on the right.
component SetupScreen inherits Rectangle {
    in property <image> qr;
    in property <bool> qr-visible;
    in property <string> step;
    in property <string> headline;
    in property <string> detail;

    background: Palette.background;

    HorizontalLayout {
        padding: 12px;
        spacing: 14px;

        if root.qr-visible: VerticalLayout {
            alignment: center;

            // The white card doubles as the quiet zone scanners need.
            Rectangle {
                width: 164px;
                height: 164px;
                border-radius: 8px;
                background: white;

                Image {
                    // Shown at its natural size: the pixel buffer is already
                    // an exact multiple of the module count, and resampling a
                    // QR code is how it stops scanning.
                    width: self.source.width * 1px;
                    height: self.source.height * 1px;
                    source: root.qr;
                    image-rendering: pixelated;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 8px;

            Text {
                text: root.step;
                color: Palette.accent;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 2px;
            }

            Text {
                text: root.headline;
                color: Palette.text;
                font-size: 16px;
                font-weight: 700;
                wrap: word-wrap;
            }

            Text {
                text: root.detail;
                color: Palette.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}

export component MainWindow inherits Window {
    in property <bool> online;
    in property <string> link-text: "STARTING";
    in property <bool> usage-known;
    in property <int> session-percent;
    in property <int> weekly-percent;
    in property <string> session-reset;
    in property <string> weekly-reset;
    in property <float> session-elapsed: -1;
    in property <float> weekly-elapsed: -1;
    in property <string> summary: "WAITING FOR WIFI";
    in property <bool> warning;

    in property <bool> setup-mode;
    in property <image> setup-qr;
    in property <bool> setup-qr-visible;
    in property <string> setup-step;
    in property <string> setup-headline;
    in property <string> setup-detail;

    callback refresh();
    /// Restart into setup; with `keep-token` only the WiFi network changes.
    callback reconfigure(keep-token: bool);

    in-out property <bool> confirming;
    // A long press ends in a release like any other; this keeps that release
    // from also counting as a tap.
    property <bool> long-pressed;
    // The finger is down (allowing for momentary drops).
    property <bool> held;
    // The finger just lifted; it may come straight back.
    property <bool> release-pending;
    // The dialog opens under the finger that held to open it, so its buttons
    // stay inert until the glass has been quiet for a moment.
    property <bool> dialog-armed;

    width: 320px;
    height: 240px;
    background: Palette.background;
    default-font-size: 12px;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        HorizontalLayout {
            height: 18px;
            spacing: 6px;

            Text {
                vertical-alignment: center;
                text: "CLAUDE USAGE";
                color: Palette.accent;
                font-size: 13px;
                font-weight: 700;
                letter-spacing: 2px;
            }

            Text {
                horizontal-alignment: right;
                vertical-alignment: center;
                text: root.link-text;
                color: Palette.muted;
                font-size: 11px;
                letter-spacing: 1px;
            }

            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.online ? Palette.ok : Palette.caution;
                }
            }
        }

        UsageMeter {
            title: "SESSION";
            window: "5 hour window";
            known: root.usage-known;
            percent: root.session-percent;
            reset-text: root.session-reset;
            elapsed: root.session-elapsed;
        }

        UsageMeter {
            title: "WEEK";
            window: "7 day window";
            known: root.usage-known;
            percent: root.weekly-percent;
            reset-text: root.weekly-reset;
            elapsed: root.weekly-elapsed;
        }

        Text {
            height: 16px;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: root.summary;
            color: root.warning ? Palette.danger : Palette.muted;
            font-size: 12px;
            letter-spacing: 1px;
            overflow: elide;
        }
    }

    // Tap anywhere to poll right away instead of waiting for the next minute;
    // hold for three seconds to reconfigure.
    //
    // A touch panel can drop a held finger for a moment, so a release only
    // counts once the finger has stayed off the glass for a little while. Taps
    // and holds are then worked out from settled releases rather than from
    // TouchArea's own `clicked`.
    touch := TouchArea {
        // Not disabled while the dialog is up: the dialog sits above and takes
        // the touches, and a TouchArea disabled mid-press keeps a stale
        // `pressed` that would swallow the next gesture.
        enabled: !root.setup-mode;

        changed pressed => {
            if self.pressed {
                if root.release-pending {
                    // Back within the grace period: the same press continues.
                    root.release-pending = false;
                } else {
                    root.held = true;
                    root.long-pressed = false;
                }
            } else {
                root.release-pending = true;
            }
        }
    }

    Timer {
        interval: 150ms;
        running: root.release-pending;

        triggered => {
            root.release-pending = false;
            root.held = false;
            if root.long-pressed {
                // The finger that opened the dialog is off the glass: the
                // dialog may take taps now.
                root.dialog-armed = true;
            } else {
                root.refresh();
            }
        }
    }

    Timer {
        interval: 3s;
        running: root.held;

        triggered => {
            root.held = false;
            root.long-pressed = true;
            root.dialog-armed = false;
            root.confirming = true;
        }
    }

    if root.setup-mode: SetupScreen {
        qr: root.setup-qr;
        qr-visible: root.setup-qr-visible;
        step: root.setup-step;
        headline: root.setup-headline;
        detail: root.setup-detail;
    }

    if root.confirming: Rectangle {
        background: Palette.background.with-alpha(0.92);

        // Swallows touches so nothing underneath reacts.
        TouchArea { }

        VerticalLayout {
            padding: 20px;
            spacing: 8px;
            alignment: center;

            Text {
                text: "Set up again?";
                color: Palette.text;
                font-size: 18px;
                font-weight: 700;
            }

            Text {
                text: "The display restarts into setup; you finish on your phone.";
                color: Palette.muted;
                font-size: 13px;
                wrap: word-wrap;
            }

            VerticalLayout {
                padding-top: 6px;
                spacing: 8px;

                DialogButton {
                    text: "ADD A WIFI NETWORK";
                    clicked => {
                        root.confirming = false;
                        root.reconfigure(true);
                    }
                }

                DialogButton {
                    text: "START OVER";
                    primary: true;
                    clicked => {
                        root.confirming = false;
                        root.reconfigure(false);
                    }
                }

                DialogButton {
                    text: "CANCEL";
                    clicked => {
                        root.confirming = false;
                    }
                }
            }
        }

        // Above the buttons until the finger that opened the dialog has
        // lifted, so that lift cannot press one.
        if !root.dialog-armed: TouchArea { }
    }
}
