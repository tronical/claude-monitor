# Copy to secrets.env (git-ignored) and fill in. Values are baked into the
# firmware at build time, so rebuild and reflash after changing them.

# 2.4 GHz network; the ESP32-S3 has no 5 GHz radio. WPA2 (WPA3-only networks
# are not supported by the bare-metal WiFi driver).
WIFI_SSID=
WIFI_PASSWORD=

# A long-lived subscription token. Create one on any machine where Claude Code
# is logged in with:
#
#   claude setup-token
#
# and paste the sk-ant-oat01-... value here. Unlike the rotating credential in
# ~/.claude/.credentials.json this one is valid for a year, which is what lets
# the display work without a companion process refreshing tokens for it.
CLAUDE_OAUTH_TOKEN=
